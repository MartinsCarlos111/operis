# Copy to .env and adjust. .env is gitignored.

# Banco único da aplicação (negócio + tabelas dedicadas do Control Plane).
# Os bancos dedicados dos tenants são registrados em TenantDatabase e
# resolvidos em runtime — não vivem em variável de ambiente.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/operis?schema=public"

JWT_SECRET="troque-este-segredo-em-producao"
# Chave mestra AES-256-GCM (32 bytes em base64) usada pelo EncryptionService
# para cifrar a senha do banco de cada tenant. Nunca vai para o banco.
ENCRYPTION_MASTER_KEY="gere-com: openssl rand -base64 32"

PORT=3000
HOST=0.0.0.0
NODE_ENV=development