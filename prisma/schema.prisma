/// Schema ÚNICO do operis. Convive aqui o domínio de negócio (estabelecimentos,
/// usuários, RBAC) e as tabelas dedicadas de administração da plataforma
/// (Control Plane: tenants, super-admins) — mesmo banco, tabelas separadas.
/// Este mesmo schema é replicado via migration nos bancos dedicados dos
/// tenants registrados em TenantDatabase.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Status genérico de atividade. Substitui booleans "ativo" por um enum
/// autodocumentado — o mesmo vocabulário para o conceito "está ativo?" em
/// todo o domínio (Linguagem Ubíqua: um termo, um significado).
enum StatusRecurso {
  ATIVO
  INATIVO
}

/// Dedo de uma digital cadastrada (substitui as 10 colunas fixas do legado
/// `Cracha`). Estruturado: permite 0..10 digitais por crachá sem colunas vazias.
enum Dedo {
  POLEGAR_ESQUERDO
  INDICADOR_ESQUERDO
  MEDIO_ESQUERDO
  ANELAR_ESQUERDO
  MINIMO_ESQUERDO
  POLEGAR_DIREITO
  INDICADOR_DIREITO
  MEDIO_DIREITO
  ANELAR_DIREITO
  MINIMO_DIREITO
}

model Estabelecimento {
  idEstabelecimento String        @id @default(uuid()) @db.Uuid
  descricao         String
  status            StatusRecurso @default(ATIVO)

  // Recursos/módulos do estabelecimento — enum de status, não boolean,
  // para documentar explicitamente o estado de cada módulo.
  impressoras StatusRecurso @default(INATIVO)
  coletores   StatusRecurso @default(INATIVO)
  checklist   StatusRecurso @default(INATIVO)
  manufatura  StatusRecurso @default(INATIVO)

  niveisAcesso        NivelAcesso[]
  vinculos            UsuarioEstabelecimento[]
  areas               Area[]
  impressorasVinculos EstabelecimentoImpressora[]
  dispositivosIot     DispositivoIot[]

  // Área Manufatura (só faz sentido quando `manufatura` está ATIVO).
  calendarios     Calendario[]
  gruposMaquina   GrupoMaquina[]
  tiposCausa      TipoCausa[]
  tiposParada     TipoParada[]
  tiposRecusa     TipoRecusa[]
  tiposRefugo     TipoRefugo[]
  centrosTrabalho CentroTrabalho[]
  artigos         Artigo[]
  configuracoesCampos ConfiguracaoCampo[]
  planosProducao  PlanoProducao[]
  ordensProducao  OrdemProducao[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("estabelecimentos")
}

/// Área de um estabelecimento (setor/local). Migrada de Octopus `Area`
/// (Principal). As 50 colunas-coringa `AuxiliaresMenu` (intAux1..10, etc.) do
/// legado foram descartadas — não eram expostas pela API e não têm uso de
/// negócio; extras futuros entram como colunas nomeadas.
///
/// `codigo` (ex-`cdArea`) é o identificador natural de negócio, único dentro do
/// estabelecimento; a PK é UUID, alinhada às demais tabelas do operis.
model Area {
  idArea    String @id @default(uuid()) @db.Uuid
  /// Código de negócio da área (ex-cdArea). Único por estabelecimento.
  codigo    String
  descricao String

  estabelecimentoId String          @map("estabelecimento_id") @db.Uuid
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [idEstabelecimento], onDelete: Cascade)

  usuarios AreaUsuario[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  // Código único dentro do estabelecimento (paridade com a regra do AreaRN:
  // "Área com o código X já cadastrada").
  @@unique([estabelecimentoId, codigo])
  @@index([estabelecimentoId])
  @@map("areas")
}

/// Junção N:N usuário ↔ área (migrada de Octopus `AreaUsuario`). Diz quais
/// usuários operam em cada área. Usada, entre outras coisas, para bloquear a
/// exclusão de uma área que ainda tem usuários vinculados (regra do AreaRN).
/// PK composta [areaId, usuarioId] — sem `idAreaUsuario` surrogate do legado.
model AreaUsuario {
  areaId    String @map("area_id") @db.Uuid
  usuarioId String @map("usuario_id") @db.Uuid

  area    Area    @relation(fields: [areaId], references: [idArea], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [idUsuario], onDelete: Cascade)

  criadoEm DateTime @default(now()) @map("criado_em")

  @@id([areaId, usuarioId])
  @@index([usuarioId])
  @@map("areas_usuarios")
}

/// Impressora — recurso GLOBAL do tenant (migrada de Octopus `Impressora`).
/// No legado NÃO pertence a um estabelecimento: o vínculo é N:N via
/// `EstabelecimentoImpressora` (módulo a migrar). Por isso o código é único no
/// tenant inteiro. Colunas Aux do legado descartadas; IDs bigint→UUID.
model Impressora {
  idImpressora String @id @default(uuid()) @db.Uuid
  /// Código de negócio (ex-cdImpressora). Único no tenant.
  codigo       String @unique
  descricao    String
  /// Endereço de rede da impressora (ex-endereco; ip/host).
  endereco     String

  estabelecimentos EstabelecimentoImpressora[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("impressoras")
}

/// Vínculo N:N estabelecimento ↔ impressora (migrado de Octopus
/// `EstabelecimentoImpressora`). Diz quais impressoras (globais) estão
/// disponíveis em cada estabelecimento. PK composta — sem o surrogate
/// `idEstabelecimentoImpressora` do legado.
model EstabelecimentoImpressora {
  estabelecimentoId String @map("estabelecimento_id") @db.Uuid
  impressoraId      String @map("impressora_id") @db.Uuid

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [idEstabelecimento], onDelete: Cascade)
  impressora      Impressora      @relation(fields: [impressoraId], references: [idImpressora], onDelete: Cascade)

  criadoEm DateTime @default(now()) @map("criado_em")

  @@id([estabelecimentoId, impressoraId])
  @@index([impressoraId])
  @@map("estabelecimentos_impressoras")
}

/// Dispositivo coletor IoT (migrado de Octopus `IOT` + `CentroTrabalhoIOT`).
/// O `serial` é a identidade do aparelho no chão de fábrica e é exatamente o
/// client_id que ele apresenta ao broker MQTT — é por ele que o status online
/// é resolvido em tempo real, sem persistir estado de conexão.
model DispositivoIot {
  idDispositivoIot String @id @default(uuid()) @db.Uuid

  /// ex-serialIOT. Identidade do aparelho e client_id MQTT. Único no tenant.
  serial         String  @unique
  /// Rótulo operacional livre (o legado não tinha; a tela precisa).
  nome           String
  /// ex-model: família de hardware, entra na routing key `devices.<model>.<serial>`.
  modelo         Int     @default(0)
  /// ex-firmwareVersion, reportado pelo próprio dispositivo no REGISTER.
  versaoFirmware String? @map("versao_firmware")
  /// Último IP conhecido. Informativo — a fonte viva é o broker.
  ip             String?

  /// Vínculo com o centro de trabalho (ex-CentroTrabalhoIOT). Texto por ora:
  /// o módulo de manufatura ainda não foi migrado.
  centroTrabalho String? @map("centro_trabalho")

  estabelecimentoId String          @map("estabelecimento_id") @db.Uuid
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [idEstabelecimento], onDelete: Cascade)

  entradas EntradaIot[]
  leituras LeituraIot[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([estabelecimentoId])
  @@map("dispositivos_iot")
}

/// Entrada digital/analógica de um coletor (migrado de Octopus `ConfigIOT`).
/// `param1..4` do legado viram campos nomeados por ausência de semântica no
/// original — mantidos como opcionais para paridade de payload com o firmware.
model EntradaIot {
  idEntradaIot String @id @default(uuid()) @db.Uuid

  dispositivoId String         @map("dispositivo_id") @db.Uuid
  dispositivo   DispositivoIot @relation(fields: [dispositivoId], references: [idDispositivoIot], onDelete: Cascade)

  /// ex-input: número da porta física no coletor (DI1 = 1, AI1 = 1, …).
  input    Int
  label    String
  tipo     TipoEntradaIot
  contexto ContextoIot
  funcao   FuncaoIot

  param1 Decimal? @db.Decimal(18, 4)
  param2 Decimal? @db.Decimal(18, 4)
  param3 Decimal? @db.Decimal(18, 4)
  param4 Decimal? @db.Decimal(18, 4)

  /// ex-analogAsDigital: lê uma porta analógica como se fosse digital.
  analogicaComoDigital Boolean @default(false) @map("analogica_como_digital")
  habilitado           Boolean @default(true)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  // Uma porta não pode ser configurada duas vezes no mesmo dispositivo.
  @@unique([dispositivoId, input, tipo])
  @@index([dispositivoId])
  @@map("entradas_iot")
}

/// Leitura enviada por um coletor (migrado de Octopus `IndicadoresIOT` +
/// `MovimentIOT`). É a série temporal bruta: cada pulso/medição vira uma linha,
/// e os contadores da tela são agregações sobre ela.
///
/// `ocorridoEm` é o instante no dispositivo; `registradoEm` é quando o worker
/// gravou — a diferença revela atraso de rede ou buffer do coletor.
model LeituraIot {
  idLeituraIot String @id @default(uuid()) @db.Uuid

  dispositivoId String         @map("dispositivo_id") @db.Uuid
  dispositivo   DispositivoIot @relation(fields: [dispositivoId], references: [idDispositivoIot], onDelete: Cascade)

  /// Porta física de origem, casada com EntradaIot.input.
  input    Int
  contexto ContextoIot
  /// Decimal (não int) porque entradas analógicas trazem medições fracionárias.
  valor    Decimal     @db.Decimal(18, 4)

  ocorridoEm   DateTime @map("ocorrido_em")
  registradoEm DateTime @default(now()) @map("registrado_em")

  /// Chave de deduplicação: o MQTT garante "ao menos uma entrega", então a
  /// mesma leitura pode chegar duas vezes numa reconexão.
  chaveEvento String @unique @map("chave_evento")

  // Consultas são sempre "leituras deste dispositivo neste intervalo".
  @@index([dispositivoId, ocorridoEm])
  @@index([dispositivoId, input, ocorridoEm])
  @@map("leituras_iot")
}

enum TipoEntradaIot {
  DIGITAL
  ANALOGICA
}

enum ContextoIot {
  PRODUCAO
  PARADA
  QUALIDADE
  MANUTENCAO
}

enum FuncaoIot {
  CONTADOR
  STATUS
  SINAL
  TEMPERATURA
  PRESSAO
}

/// Crachá (migrado de Octopus `Cracha`). Identifica uma pessoa nos terminais.
/// As 10 colunas fixas de digital do legado viram a tabela filha
/// `CrachaBiometria` (1:N) — modelo correto: 0..10 digitais, com formato do SDK
/// e template cifrado. Colunas Aux descartadas; `ativo`(bool)→StatusRecurso.
model Cracha {
  idCracha String        @id @default(uuid()) @db.Uuid
  /// Código de negócio (ex-cdCracha). Único no tenant.
  codigo   String        @unique
  nome     String
  status   StatusRecurso @default(ATIVO)

  biometrias CrachaBiometria[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("crachas")
}

/// Digital cadastrada de um crachá (1:N). Substitui as 10 colunas fixas do
/// legado. O `template` é o vetor de minúcias do SDK, armazenado CIFRADO
/// (AES-256-GCM via EncryptionService, como TenantDatabase) — dado biométrico
/// sensível. `formato` registra qual SDK/padrão gerou o template (permite
/// trocar de leitor no futuro). O enroll/match é feito pelo gateway externo
/// `operis-bio-bridge`, não pelo backend.
model CrachaBiometria {
  idCrachaBiometria String @id @default(uuid()) @db.Uuid

  crachaId String @map("cracha_id") @db.Uuid
  cracha   Cracha @relation(fields: [crachaId], references: [idCracha], onDelete: Cascade)

  dedo Dedo

  /// Template de minúcias do SDK, serializado e cifrado (nunca em texto puro).
  templateCifrado String @map("template_cifrado")
  /// Versão da estratégia de criptografia — rotação de chave sem quebrar o antigo.
  versaoCripto    Int    @default(1) @map("versao_cripto")
  /// SDK/padrão que gerou o template (ex.: "NITGEN", "ISO_19794_2").
  formato         String
  /// Score de qualidade do enroll fornecido pelo SDK (0-100), quando disponível.
  qualidade       Int?

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  // Um dedo só pode ter uma digital cadastrada por crachá.
  @@unique([crachaId, dedo])
  @@index([crachaId])
  @@map("crachas_biometrias")
}

/// Variável de layout de etiqueta (migrada de Octopus `VariavelLayout`). Define
/// um campo que pode ser referenciado num template de etiqueta, mapeando para o
/// campo de origem em manufatura/coletores. Código único no tenant.
model VariavelLayout {
  idVariavel              String @id @default(uuid()) @db.Uuid
  /// Código de negócio (ex-cdVariavel). Único no tenant.
  codigo                  String @unique
  descricao               String
  /// Campo de origem na etiqueta de manufatura (ex-campoEtiquetaManufatura).
  campoEtiquetaManufatura String @default("") @map("campo_etiqueta_manufatura")
  /// Campo de origem na etiqueta de coletores (ex-campoEtiquetaColetores).
  campoEtiquetaColetores  String @default("") @map("campo_etiqueta_coletores")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("variaveis_layout")
}

/// Layout de etiqueta (migrado de Octopus `LayoutEtiqueta`). Guarda o template
/// ZPL (linguagem das impressoras Zebra) que é enviado à impressora. Código
/// único no tenant.
model LayoutEtiqueta {
  idLayout  String @id @default(uuid()) @db.Uuid
  /// Código de negócio (ex-cdLayout). Único no tenant.
  codigo    String @unique
  descricao String
  /// Template ZPL da etiqueta (ex-layoutZpl).
  zpl       String @default("")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("layouts_etiqueta")
}

/// Regra de notificação (migrada de Octopus `RegraNotificacao`). Define QUANDO e
/// PARA QUEM notificar sobre um registro de um produto/tabela. O motor de
/// disparo (avaliação das condições em runtime) e o realtime NÃO fazem parte
/// deste módulo — só o cadastro (regra + condições). `ativo` (bool no legado)
/// vira StatusRecurso; código único no tenant; colunas Aux descartadas.
model RegraNotificacao {
  idRegraNotificacao String        @id @default(uuid()) @db.Uuid
  /// Código de negócio (ex-cdRegraNotificacao). Único no tenant.
  codigo             String        @unique
  descricao          String
  /// Destinatários da notificação (lista/expressão — texto livre no legado).
  destinatarios      String        @default("")
  /// Produto de origem (ex-cdProduto; ex.: "Manufatura").
  produto            String        @default("")
  /// Tabela monitorada (ex-dsTabela; ex.: "MOVIMENTOS").
  tabela             String
  /// Template/conteúdo da notificação (ex-dsConteudoNotificacao).
  conteudo           String
  status             StatusRecurso @default(ATIVO)

  condicoes CondicaoNotificacao[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("regras_notificacao")
}

/// Condição de uma regra de notificação (migrada de `CondicaoNotificacao`).
/// 1:N com RegraNotificacao — a regra dispara quando as condições casam.
/// Cada condição = (campo, operador, valor).
model CondicaoNotificacao {
  idCondicaoNotificacao String @id @default(uuid()) @db.Uuid

  regraNotificacaoId String           @map("regra_notificacao_id") @db.Uuid
  regra              RegraNotificacao @relation(fields: [regraNotificacaoId], references: [idRegraNotificacao], onDelete: Cascade)

  /// Campo monitorado (ex-cdCampo).
  campo    String
  /// Operador da condição (ex-cdCondicao; ex.: "=", ">", "CONTEM").
  operador String
  /// Valor comparado (ex-dsValor).
  valor    String @default("")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([regraNotificacaoId])
  @@map("condicoes_notificacao")
}

/// Catálogo de permissões. Nomes no padrão `grupo` ou `grupo:acao`
/// (ex.: "principal:list", "manufatura:create"). Os grupos espelham os
/// módulos do estabelecimento (principal, impressoras, coletores, checklist,
/// manufatura). É a fonte para o front listar/selecionar permissões.
model Permissao {
  idPermissao String @id @default(uuid()) @db.Uuid
  /// Chave única no padrão grupo:acao usada na verificação em runtime.
  chave       String @unique
  grupo       String
  descricao   String

  niveis NivelAcessoPermissao[]

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([grupo])
  @@map("permissoes")
}

model ConfiguracaoCampo {
  idConfiguracaoCampo String          @id @default(uuid()) @db.Uuid
  estabelecimentoId   String          @map("estabelecimento_id") @db.Uuid
  estabelecimento     Estabelecimento @relation(fields: [estabelecimentoId], references: [idEstabelecimento], onDelete: Cascade)
  tela                String
  campo               String
  visivel             Boolean         @default(true)
  ordem               Int             @default(0)
  criadoEm            DateTime        @default(now()) @map("criado_em")
  atualizadoEm        DateTime        @updatedAt @map("atualizado_em")

  @@unique([estabelecimentoId, tela, campo])
  @@index([estabelecimentoId, tela])
  @@map("configuracoes_campos")
}

/// Nível de acesso (perfil), escopado por estabelecimento — multi-tenant.
/// Cada nível seleciona um subconjunto de permissões do catálogo.
model NivelAcesso {
  idNivelAcesso String        @id @default(uuid()) @db.Uuid
  nome          String
  descricao     String        @default("")
  status        StatusRecurso @default(ATIVO)

  estabelecimentoId String          @map("estabelecimento_id") @db.Uuid
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [idEstabelecimento], onDelete: Cascade)

  permissoes NivelAcessoPermissao[]
  vinculos   UsuarioEstabelecimento[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  // Nome do nível é único dentro do estabelecimento.
  @@unique([estabelecimentoId, nome])
  @@index([estabelecimentoId])
  @@map("niveis_acesso")
}

/// Junção N:N entre nível de acesso e permissão (as permissões que aquele
/// nível disponibiliza).
model NivelAcessoPermissao {
  nivelAcessoId String @map("nivel_acesso_id") @db.Uuid
  permissaoId   String @map("permissao_id") @db.Uuid

  nivelAcesso NivelAcesso @relation(fields: [nivelAcessoId], references: [idNivelAcesso], onDelete: Cascade)
  permissao   Permissao   @relation(fields: [permissaoId], references: [idPermissao], onDelete: Cascade)

  @@id([nivelAcessoId, permissaoId])
  @@index([permissaoId])
  @@map("niveis_acesso_permissoes")
}

model Usuario {
  movimentosRegistrados Movimento[] @relation("MovimentosRegistrados")
  movimentosCancelados  Movimento[] @relation("MovimentosCancelados")
  idUsuario String  @id @default(uuid()) @db.Uuid
  nome      String
  email     String  @unique
  biometria Boolean @default(false)

  status StatusRecurso @default(ATIVO)

  // Conjunto flexível de regras de login (expiração de senha, MFA, etc).
  // JSON porque a forma varia e não queremos migração a cada nova política.
  politicasLogin Json? @map("politicas_login")

  // Um usuário pode estar vinculado a vários estabelecimentos, com um nível
  // de acesso em cada (multi-tenant). O vínculo carrega o nível.
  vinculos UsuarioEstabelecimento[]
  areas    AreaUsuario[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("usuarios")
}

/// Vínculo usuário ↔ estabelecimento ↔ nível de acesso. Resolve "qual nível
/// (e portanto quais permissões) este usuário tem neste estabelecimento".
/// PK composta [usuarioId, estabelecimentoId].
model UsuarioEstabelecimento {
  usuarioId         String        @map("usuario_id") @db.Uuid
  estabelecimentoId String        @map("estabelecimento_id") @db.Uuid
  nivelAcessoId     String        @map("nivel_acesso_id") @db.Uuid
  status            StatusRecurso @default(ATIVO)

  usuario         Usuario         @relation(fields: [usuarioId], references: [idUsuario], onDelete: Cascade)
  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [idEstabelecimento], onDelete: Cascade)
  nivelAcesso     NivelAcesso     @relation(fields: [nivelAcessoId], references: [idNivelAcesso])

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@id([usuarioId, estabelecimentoId])
  @@index([estabelecimentoId])
  @@index([nivelAcessoId])
  @@map("usuarios_estabelecimentos")
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTROL PLANE — tabelas dedicadas de administração da plataforma, no MESMO
// banco. Só o painel /admin (super-admins) enxerga estas tabelas; nenhum
// módulo de negócio deve referenciá-las.
// ─────────────────────────────────────────────────────────────────────────────

/// Situação operacional da conexão com o banco dedicado de um tenant.
enum StatusConexao {
  PROVISIONANDO
  ONLINE
  OFFLINE
  ERRO
}

/// Tenant — o cliente da plataforma. Separado de TenantDatabase para permitir
/// trocar de banco (migração de provedor, por exemplo) sem recriar o tenant.
/// Só super-admins sabem que esta tabela existe.
model Tenant {
  idTenant String        @id @default(uuid()) @db.Uuid
  nome     String
  slug     String        @unique
  status   StatusRecurso @default(ATIVO)

  database        TenantDatabase?
  rabbitmq        TenantRabbitMq?
  smtp            TenantSmtp?
  administradores TenantAdministrador[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("tenants")
}

/// Configuração de conexão com o banco dedicado do tenant. Host/porta/nome em
/// texto; a senha SEMPRE cifrada (AES-256-GCM) — só o EncryptionService
/// decifra, apenas no momento de abrir a conexão real. Nunca exposta na API.
model TenantDatabase {
  idTenantDatabase String @id @default(uuid()) @db.Uuid

  tenantId String @unique @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [idTenant], onDelete: Cascade)

  databaseProvider String @default("postgresql") @map("database_provider")
  databaseHost     String @map("database_host")
  databasePort     Int    @map("database_port")
  databaseName     String @map("database_name")
  databaseUsername String @map("database_username")

  /// iv + authTag + ciphertext serializados. Nunca em texto puro.
  databasePasswordEncrypted String @map("database_password_encrypted")
  /// Versão da estratégia de criptografia — permite rotacionar a chave mestra
  /// sem quebrar registros antigos (reencriptação gradual).
  databaseEncryptionVersion Int    @default(1) @map("database_encryption_version")

  sslEnabled Boolean @default(true) @map("ssl_enabled")

  connectionStatus StatusConexao @default(PROVISIONANDO) @map("connection_status")
  lastConnectionAt DateTime?     @map("last_connection_at")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("tenants_databases")
}

/// Configuração do broker RabbitMQ dedicado de um tenant — parte do Control
/// Plane, gerida pelo super-admin no painel /admin. Segue o mesmo padrão de
/// TenantDatabase: a senha vai apenas cifrada (AES-256-GCM via EncryptionService,
/// com versão para rotação de chave), nunca em texto puro.
model TenantRabbitMq {
  idTenantRabbitMq String @id @default(uuid()) @db.Uuid

  tenantId String @unique @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [idTenant], onDelete: Cascade)

  host        String
  porta       Int
  virtualHost String @default("/") @map("virtual_host")
  usuario     String

  /// iv + authTag + ciphertext serializados. Nunca em texto puro.
  senhaEncrypted    String @map("senha_encrypted")
  encryptionVersion Int    @default(1) @map("encryption_version")

  sslEnabled Boolean @default(false) @map("ssl_enabled")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("tenants_rabbitmq")
}

/// Configuração do servidor SMTP dedicado de um tenant — parte do Control Plane,
/// gerida pelo super-admin. Mesmo padrão de segredo cifrado do TenantDatabase.
model TenantSmtp {
  idTenantSmtp String @id @default(uuid()) @db.Uuid

  tenantId String @unique @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [idTenant], onDelete: Cascade)

  host      String
  porta     Int
  usuario   String
  /// Remetente padrão (From) das mensagens enviadas por este tenant.
  remetente String @default("")

  /// iv + authTag + ciphertext serializados. Nunca em texto puro.
  senhaEncrypted    String @map("senha_encrypted")
  encryptionVersion Int    @default(1) @map("encryption_version")

  sslEnabled Boolean @default(true) @map("ssl_enabled")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("tenants_smtp")
}

/// Administrador de UM tenant específico. Vive no Control Plane (não no banco
/// do tenant) porque o login precisa descobrir "qual tenant" a partir do email
/// antes de saber qual banco consultar. Criado pelo super-admin junto com o
/// tenant.
model TenantAdministrador {
  idTenantAdministrador String        @id @default(uuid()) @db.Uuid
  nome                  String
  email                 String        @unique
  senhaHash             String        @map("senha_hash")
  status                StatusRecurso @default(ATIVO)

  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [idTenant], onDelete: Cascade)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([tenantId])
  @@map("tenants_administradores")
}

/// Super-administrador — equipe interna de manutenção/suporte do operis.
/// SEM relação com Tenant: são os únicos que sabem que tenants existem.
/// Login isolado (rotas /admin, painel próprio), nunca compartilhado com
/// TenantAdministrador.
model SuperAdmin {
  idSuperAdmin String        @id @default(uuid()) @db.Uuid
  nome         String
  email        String        @unique
  senhaHash    String        @map("senha_hash")
  status       StatusRecurso @default(ATIVO)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("super_admins")
}

// ============================================================================
// ÁREA MANUFATURA
// ----------------------------------------------------------------------------
// Migrada de Octopus.Modelo/Manufatura (banco físico MANUFATURA do legado).
// Aqui convive no mesmo Postgres do tenant — o isolamento do operis é por
// tenant, não por produto (ver docs/migracao-octopus.md).
//
// Convenções herdadas do domínio Principal: PK UUID, "codigo" como
// identificador natural de negócio único por estabelecimento, e as colunas
// coringa AuxiliaresManufatura (intAux1..10 etc.) DESCARTADAS — não têm uso de
// negócio; extras futuros entram como colunas nomeadas.
// ============================================================================

/// ex-EnumTratamentoTempo. Como o tempo padrão da operação é aplicado.
enum TratamentoTempo {
  FIXO
  PROPORCIONAL
  FERRAMENTAL
  LOTE
}

/// ex-EnumTipoUnidadeMedida.
enum TipoUnidadeMedida {
  UNIDADE
  METRAGEM
  PESO
  AREA
  VOLUME
  ESPECIFICA
}

/// ex-EnumCriticidadeParada. Compartilhada por TipoParada/Causa/Recusa/Refugo —
/// no legado era uma string "Criticidade" solta em cada uma delas.
enum CriticidadeParada {
  PLANEJADA
  BAIXA
  NORMAL
  ALTA
  CRITICA
  IMPEDITIVA
}

/// ex-EnumRegraDespacho (GrupoMaquina.RegraDespacho, string no legado).
enum RegraDespacho {
  MENOR_OPERACAO
  DATA_ENTREGA
  PRIORIDADE
  CODIGO_REDUTOR
}

enum StatusOrdemProducao {
  LIBERADA
  NAO_LIBERADA
  INICIADA
  CONGELADA
  RECUSADA
  CONCLUIDA
  CANCELADA
  BAIXADA
}

enum OrigemOrdemProducao {
  OCTOPUS
  ERP
  TERMINAL
  PLANO
}

enum ModoDistribuicaoOrdem {
  PUXADA
  EMPURRADA
}

/// ex-EnumTipoCausa.
enum TipoCausaClassificacao {
  MANUTENCAO
  PARADA
}

/// ex-EnumTipoParada.
enum TipoParadaClassificacao {
  CONTROLA_MANUTENCAO
  INFORMA_CAUSA
}

/// ex-EnumOrigem (TipoRecusa.Origem, string no legado).
enum OrigemRecusa {
  PRODUCAO
  MANUTENCAO
  QUALIDADE
  IMPRESSAO
}

/// Calendário de produção (migrado de Octopus `Calendario`). Define a jornada
/// que o Centro de Trabalho usa para calcular disponibilidade. Pertence a um
/// estabelecimento — o CentroTrabalhoRN valida que ele existe, que o
/// estabelecimento está ativo e que tem o produto Manufatura habilitado.
model Calendario {
  idCalendario String        @id @default(uuid()) @db.Uuid
  codigo       String
  descricao    String
  status       StatusRecurso @default(ATIVO)

  estabelecimentoId String          @map("estabelecimento_id") @db.Uuid
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [idEstabelecimento], onDelete: Cascade)

  centrosTrabalho CentroTrabalho[]
  turnos          Turno[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@unique([estabelecimentoId, codigo])
  @@index([estabelecimentoId])
  @@map("calendarios")
}

/// Grupo de máquina (migrado de Octopus `GrupoMaquina`). Agrupa centros de
/// trabalho equivalentes e carrega a regra de despacho do sequenciamento.
model GrupoMaquina {
  idGrupoMaquina String        @id @default(uuid()) @db.Uuid
  codigo         String
  descricao      String
  status         StatusRecurso @default(ATIVO)
  regraDespacho  RegraDespacho @default(DATA_ENTREGA) @map("regra_despacho")

  estabelecimentoId String          @map("estabelecimento_id") @db.Uuid
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [idEstabelecimento], onDelete: Cascade)

  centrosTrabalho CentroTrabalho[]
  planosProducao PlanoProducao[]
  ordensProducao OrdemProducao[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@unique([estabelecimentoId, codigo])
  @@index([estabelecimentoId])
  @@map("grupos_maquina")
}

/// Tipo de causa de parada (migrado de Octopus `TipoCausa`).
model TipoCausa {
  movimentos Movimento[]
  idTipoCausa        String                  @id @default(uuid()) @db.Uuid
  codigo             String
  descricao          String
  /// ex-DsDetalhada: orientação longa ao operador.
  descricaoDetalhada String?                 @map("descricao_detalhada")
  criticidade        CriticidadeParada       @default(NORMAL)
  classificacao      TipoCausaClassificacao?
  status             StatusRecurso           @default(ATIVO)

  estabelecimentoId String          @map("estabelecimento_id") @db.Uuid
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [idEstabelecimento], onDelete: Cascade)

  centrosTrabalho CentroTrabalho[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@unique([estabelecimentoId, codigo])
  @@index([estabelecimentoId])
  @@map("tipos_causa")
}

/// Tipo de parada (migrado de Octopus `TipoParada`). `consideraOee` decide se
/// a parada entra no cálculo de disponibilidade do OEE.
model TipoParada {
  movimentos Movimento[]
  idTipoParada        String                   @id @default(uuid()) @db.Uuid
  codigo              String
  descricao           String
  consideraOee        Boolean                  @default(true) @map("considera_oee")
  classificacao       TipoParadaClassificacao?
  /// ex-ParadaPadrao (TimeSpan) → minutos inteiros, unidade explícita.
  paradaPadraoMinutos Int?                     @map("parada_padrao_minutos")
  utilizaParadaPadrao Boolean                  @default(false) @map("utiliza_parada_padrao")
  criticidade         CriticidadeParada        @default(NORMAL)
  status              StatusRecurso            @default(ATIVO)

  estabelecimentoId String          @map("estabelecimento_id") @db.Uuid
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [idEstabelecimento], onDelete: Cascade)

  centrosTrabalho CentroTrabalho[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@unique([estabelecimentoId, codigo])
  @@index([estabelecimentoId])
  @@map("tipos_parada")
}

/// Tipo de recusa (migrado de Octopus `TipoRecusa`).
model TipoRecusa {
  movimentos Movimento[]
  idTipoRecusa String            @id @default(uuid()) @db.Uuid
  codigo       String
  descricao    String
  origem       OrigemRecusa      @default(PRODUCAO)
  criticidade  CriticidadeParada @default(NORMAL)
  status       StatusRecurso     @default(ATIVO)

  estabelecimentoId String          @map("estabelecimento_id") @db.Uuid
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [idEstabelecimento], onDelete: Cascade)

  centrosTrabalho CentroTrabalho[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@unique([estabelecimentoId, codigo])
  @@index([estabelecimentoId])
  @@map("tipos_recusa")
}

/// Tipo de refugo (migrado de Octopus `TipoRefugo`). `consideraOee` decide se
/// o refugo entra no índice de qualidade.
model TipoRefugo {
  movimentos Movimento[]
  idTipoRefugo       String            @id @default(uuid()) @db.Uuid
  codigo             String
  descricao          String
  consideraOee       Boolean           @default(true) @map("considera_oee")
  possivelRetrabalho Boolean           @default(false) @map("possivel_retrabalho")
  criticidade        CriticidadeParada @default(NORMAL)
  status             StatusRecurso     @default(ATIVO)

  estabelecimentoId String          @map("estabelecimento_id") @db.Uuid
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [idEstabelecimento], onDelete: Cascade)

  centrosTrabalho CentroTrabalho[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@unique([estabelecimentoId, codigo])
  @@index([estabelecimentoId])
  @@map("tipos_refugo")
}

/// Centro de Trabalho (migrado de Octopus `CentroTrabalho`) — o recurso
/// produtivo onde as operações são apontadas.
///
/// Campos portados = os que o ConfigCampos do legado expõe na tela
/// (cdCentroTrabalho, dsCentroTrabalho, ativo, controlaMaoObra, preparacao,
/// operacaoBaixada, tempoParadaPadrao, tipoUnidadeMedida, tratamentoTempo,
/// tratamentoTempoLote e as quatro metas de turno) + custoMaquinaHora, que o
/// CentroTrabalhoRN valida explicitamente.
///
/// DESCARTADOS por não terem uso vivo no cadastro (nenhum aparece no
/// ConfigCampos da tela): colunas AuxiliaresManufatura, campos de integração
/// legada (CdFabrica, CdERP, IdMaquinaBancoIntegracao, TimerIntegracao,
/// OrdemOctopus, AdicionaisApontamento, TipoMovimentoApontamento) e as metas de
/// produção hora/dia/mês.
///
/// A FK opcional para Equipamento ficou fora desta migração: o
/// EquipamentoManufatura legado tem ~50 campos, 12 FKs de botão apontando de
/// volta para CentroTrabalho e depende de Terminais, que ainda não existe.
model CentroTrabalho {
  movimentos Movimento[]
  idCentroTrabalho String        @id @default(uuid()) @db.Uuid
  codigo           String
  descricao        String
  status           StatusRecurso @default(ATIVO)

  /// Obrigatório — CentroTrabalhoRN.ValidarCentroTrabalho: "Informe um calendário."
  calendarioId String     @map("calendario_id") @db.Uuid
  calendario   Calendario @relation(fields: [calendarioId], references: [idCalendario])

  /// Opcionais: validados só quando informados (paridade com o RN).
  grupoMaquinaId String?       @map("grupo_maquina_id") @db.Uuid
  grupoMaquina   GrupoMaquina? @relation(fields: [grupoMaquinaId], references: [idGrupoMaquina])
  tipoCausaId    String?       @map("tipo_causa_id") @db.Uuid
  tipoCausa      TipoCausa?    @relation(fields: [tipoCausaId], references: [idTipoCausa])
  tipoParadaId   String?       @map("tipo_parada_id") @db.Uuid
  tipoParada     TipoParada?   @relation(fields: [tipoParadaId], references: [idTipoParada])
  tipoRecusaId   String?       @map("tipo_recusa_id") @db.Uuid
  tipoRecusa     TipoRecusa?   @relation(fields: [tipoRecusaId], references: [idTipoRecusa])
  tipoRefugoId   String?       @map("tipo_refugo_id") @db.Uuid
  tipoRefugo     TipoRefugo?   @relation(fields: [tipoRefugoId], references: [idTipoRefugo])

  controlaMaoObra Boolean @default(false) @map("controla_mao_obra")
  preparacao      Boolean @default(false)
  /// ex-OperacaoBaixada: nº da operação baixada automaticamente.
  operacaoBaixada Int?    @map("operacao_baixada")

  /// ex-TempoParadaPadrao (TimeSpan) → minutos inteiros, unidade explícita.
  tempoParadaPadraoMinutos Int               @default(0) @map("tempo_parada_padrao_minutos")
  tratamentoTempo          TratamentoTempo   @default(FIXO) @map("tratamento_tempo")
  /// Tamanho do lote quando tratamentoTempo = LOTE.
  tratamentoTempoLote      Decimal?          @map("tratamento_tempo_lote") @db.Decimal(18, 4)
  tipoUnidadeMedida        TipoUnidadeMedida @default(UNIDADE) @map("tipo_unidade_medida")

  /// Metas de turno (%).
  metaDispTurno   Decimal? @map("meta_disp_turno") @db.Decimal(5, 2)
  metaDesempTurno Decimal? @map("meta_desemp_turno") @db.Decimal(5, 2)
  metaQualiTurno  Decimal? @map("meta_quali_turno") @db.Decimal(5, 2)
  metaOeeTurno    Decimal? @map("meta_oee_turno") @db.Decimal(5, 2)
  /// CentroTrabalhoRN recusa valor negativo.
  custoMaquinaHora Decimal @default(0) @map("custo_maquina_hora") @db.Decimal(18, 4)

  estabelecimentoId String          @map("estabelecimento_id") @db.Uuid
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [idEstabelecimento], onDelete: Cascade)
  artigosCentros    ArtigoCentroTrabalho[]
  planosProducao    PlanoProducao[]
  ordensProducao    OrdemProducao[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@unique([estabelecimentoId, codigo])
  @@index([estabelecimentoId])
  @@index([calendarioId])
  @@index([grupoMaquinaId])
  @@map("centros_trabalho")
}

/// Artigo/item de manufatura. O cadastro e global somente dentro do tenant;
/// o relacionamento produtivo e definido por CentroTrabalho.
model Artigo {
  idArtigo String @id @default(uuid()) @map("id_artigo") @db.Uuid
  codigo String
  descricao String
  qualidades String?
  status StatusRecurso @default(ATIVO)
  estabelecimentoId String @map("estabelecimento_id") @db.Uuid
  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [idEstabelecimento], onDelete: Cascade)
  centrosTrabalho ArtigoCentroTrabalho[]
  criadoEm DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")
  @@unique([estabelecimentoId, codigo])
  @@index([estabelecimentoId, status])
  @@map("artigos")
}

/// Parametros do artigo em um centro de trabalho (legado CentroTrabalhoItem).
model ArtigoCentroTrabalho {
  idArtigoCentroTrabalho String @id @default(uuid()) @map("id_artigo_centro_trabalho") @db.Uuid
  artigoId String @map("artigo_id") @db.Uuid
  centroTrabalhoId String @map("centro_trabalho_id") @db.Uuid
  cicloProdutivoHora Float @default(0) @map("ciclo_produtivo_hora")
  cicloProdutivoPecaSegundos Float @default(0) @map("ciclo_produtivo_peca_segundos")
  tempoPreparacaoSegundos Float @default(0) @map("tempo_preparacao_segundos")
  fatorRefugo Float @default(0) @map("fator_refugo")
  quantidadeRefugo Float @default(0) @map("quantidade_refugo")
  quantidadePerda Float @default(0) @map("quantidade_perda")
  apontarPreparacao Float @default(0) @map("apontar_preparacao")
  tempoMaquinaSegundos Float @default(0) @map("tempo_maquina_segundos")
  loteMultiplo Float @default(0) @map("lote_multiplo")
  ativo Boolean @default(true)
  artigo Artigo @relation(fields: [artigoId], references: [idArtigo], onDelete: Cascade)
  centroTrabalho CentroTrabalho @relation(fields: [centroTrabalhoId], references: [idCentroTrabalho], onDelete: Cascade)
  criadoEm DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")
  @@unique([artigoId, centroTrabalhoId])
  @@index([centroTrabalhoId, ativo])
  @@map("artigos_centros_trabalho")
}

/// Plano de producao usado para gerar ordens previamente planejadas.
model PlanoProducao {
  idPlanoProducao String @id @default(uuid()) @db.Uuid
  codigo         String
  descricao      String
  itemCodigo     String
  itemDescricao  String?
  quantidade     Float
  unidadeMedida  TipoUnidadeMedida @default(UNIDADE) @map("unidade_medida")
  inicioPlanejado DateTime? @map("inicio_planejado")
  fimPlanejado    DateTime? @map("fim_planejado")
  status          StatusRecurso @default(ATIVO)

  estabelecimentoId String @map("estabelecimento_id") @db.Uuid
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [idEstabelecimento], onDelete: Cascade)
  centroTrabalhoId  String? @map("centro_trabalho_id") @db.Uuid
  centroTrabalho    CentroTrabalho? @relation(fields: [centroTrabalhoId], references: [idCentroTrabalho])
  grupoMaquinaId    String? @map("grupo_maquina_id") @db.Uuid
  grupoMaquina      GrupoMaquina? @relation(fields: [grupoMaquinaId], references: [idGrupoMaquina])
  ordensProducao    OrdemProducao[]

  criadoEm DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@unique([estabelecimentoId, codigo])
  @@index([estabelecimentoId, status])
  @@map("planos_producao")
}

/// Ordem de producao. A combinacao codigo + identificador preserva a
/// identidade externa do legado e permanece unica dentro do tenant.
model OrdemProducao {
  movimentos Movimento[]
  idOrdemProducao String @id @default(uuid()) @map("id_ordem_producao") @db.Uuid
  codigo         String
  identificador String
  itemCodigo     String @map("item_codigo")
  itemDescricao  String? @map("item_descricao")
  quantidadePlanejada Float @map("quantidade_planejada")
  quantidadeProduzida Float @default(0) @map("quantidade_produzida")
  quantidadeRefugo Float @default(0) @map("quantidade_refugo")
  unidadeMedida TipoUnidadeMedida @default(UNIDADE) @map("unidade_medida")
  status StatusOrdemProducao @default(LIBERADA)
  origem OrigemOrdemProducao @default(OCTOPUS)
  modoDistribuicao ModoDistribuicaoOrdem @default(PUXADA) @map("modo_distribuicao")
  prioridade Int @default(999999)
  prioridadeCodigoRedutor Int @default(999999) @map("prioridade_codigo_redutor")
  sequencia Int @default(999999)
  centroTrabalhoValido String? @map("centro_trabalho_valido")
  cliente String?
  pedido String?
  observacoes String?
  criadaEm DateTime @default(now()) @map("criada_em")
  liberacaoEm DateTime? @map("liberacao_em")
  inicioPlanejado DateTime? @map("inicio_planejado")
  fimPlanejado DateTime? @map("fim_planejado")
  encerraEm DateTime? @map("encerra_em")

  estabelecimentoId String @map("estabelecimento_id") @db.Uuid
  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [idEstabelecimento], onDelete: Cascade)
  centroTrabalhoId String? @map("centro_trabalho_id") @db.Uuid
  centroTrabalho CentroTrabalho? @relation(fields: [centroTrabalhoId], references: [idCentroTrabalho])
  grupoMaquinaId String? @map("grupo_maquina_id") @db.Uuid
  grupoMaquina GrupoMaquina? @relation(fields: [grupoMaquinaId], references: [idGrupoMaquina])
  planoProducaoId String? @map("plano_producao_id") @db.Uuid
  planoProducao PlanoProducao? @relation(fields: [planoProducaoId], references: [idPlanoProducao])
  ordemPaiId String? @map("ordem_pai_id") @db.Uuid
  ordemPai OrdemProducao? @relation("OrdemPai", fields: [ordemPaiId], references: [idOrdemProducao])
  ordensFilhas OrdemProducao[] @relation("OrdemPai")
  ordemSequenciaId String? @map("ordem_sequencia_id") @db.Uuid
  ordemSequencia OrdemProducao? @relation("OrdemSequencia", fields: [ordemSequenciaId], references: [idOrdemProducao])
  ordensSequenciadas OrdemProducao[] @relation("OrdemSequencia")
  reservas           Reserva[]

  criadoEm DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@unique([codigo, identificador])
  @@index([estabelecimentoId, status])
  @@index([estabelecimentoId, inicioPlanejado])
  @@map("ordens_producao")
}

/// Dia da semana em que um turno é praticado. No legado era a string
/// `Turno.DiaDaSemana` (lista serializada); aqui é um array de enum.
enum DiaSemana {
  DOMINGO
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}

/// Turno de produção (migrado de Octopus `Turno`). Pertence a um Calendário e
/// é o recorte de tempo sobre o qual o OEE é calculado — todo Movimento
/// referencia obrigatoriamente um turno (`MovimentosRN.ValidarMovimento`:
/// "Informe um turno válido.").
///
/// DIVERGÊNCIA DELIBERADA vs legado: lá `DtHrInicioTurno`/`DtHrFimTurno` são
/// `DateTime` cuja parte de DATA é descartada — `TurnoRN` e
/// `CalculoIndicadoresRN` reparseiam apenas o `HH:mm:ss` sobre o dia alvo.
/// Guardar isso como DateTime convidava ao erro de comparar datas que não
/// significam nada. Aqui são minutos desde a meia-noite (0..1439), o que também
/// torna o turno que cruza a meia-noite representável sem ambiguidade — o
/// legado tinha uma incoerência aí: `ValidarTurno` recusava início > fim,
/// enquanto o runtime somava 1 dia ao fim justamente para suportar esse caso.
/// Mantivemos o comportamento do RUNTIME (o que a fábrica de fato usa).
model Turno {
  movimentos Movimento[]
  idTurno   String @id @default(uuid()) @db.Uuid
  codigo    String
  descricao String

  calendarioId String     @map("calendario_id") @db.Uuid
  calendario   Calendario @relation(fields: [calendarioId], references: [idCalendario], onDelete: Cascade)

  /// Minutos desde a meia-noite (0..1439). início >= fim ⇒ turno vira o dia.
  inicioMinutos Int @map("inicio_minutos")
  fimMinutos    Int @map("fim_minutos")

  /// ex-TempoTotal / TempoDisponivel (TimeSpan) → minutos, unidade explícita.
  /// Invariantes do TurnoRN: nenhum pode ser zero e disponível <= total.
  tempoTotalMinutos     Int @map("tempo_total_minutos")
  tempoDisponivelMinutos Int @map("tempo_disponivel_minutos")

  /// Não pode ser vazio ("Selecione ao menos um dia da semana.").
  diasSemana DiaSemana[] @map("dias_semana")

  /// ex-Util: turno em dia útil (vs. fim de semana/feriado).
  util       Boolean       @default(true)
  observacao String?
  status     StatusRecurso @default(ATIVO)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@unique([calendarioId, codigo])
  @@index([calendarioId])
  @@map("turnos")
}

/// ex-EnumStatusReserva. No legado eram inteiros (0/1/2); aqui, nomes.
enum StatusReserva {
  NAO_REQUISITADA
  REQUISITADA
  CANCELADA
}

/// Reserva de material de uma Ordem de Produção (migrada de Octopus `Reserva`).
/// É o insumo que o terminal requisita e devolve — os movimentos de
/// `Requisicao`/`Devolucao` apontam para ela (`MovimentosRN.ValidarMovimento`:
/// "Movimentos do tipo 'X' precisam de uma Reserva associada.").
///
/// A identidade natural do legado é (ordem + item + sequência): é por essa
/// tripla que `BuscarIdReserva` resolve a reserva vinda do terminal.
///
/// DESCARTADOS: colunas `AuxiliaresManufatura` (sem uso de negócio) e
/// `CdItemPrimario`/`CdReferencia`, que no legado só transitam na integração ERP
/// e não têm consumidor no cadastro — entram como colunas nomeadas quando a
/// integração for migrada.
model Reserva {
  movimentos Movimento[]
  idReserva String @id @default(uuid()) @db.Uuid

  ordemProducaoId String        @map("ordem_producao_id") @db.Uuid
  ordemProducao   OrdemProducao @relation(fields: [ordemProducaoId], references: [idOrdemProducao], onDelete: Cascade)

  /// >= 1 (ReservaRN: "A sequência da reserva não pode ser menor do que '1'").
  sequencia Int
  itemCodigo    String  @map("item_codigo")
  itemDescricao String  @map("item_descricao")
  lote          String?
  unidadeMedida String? @map("unidade_medida")

  /// Todas >= 0 (ReservaRN valida as três separadamente).
  quantidadeReserva    Decimal @default(0) @map("quantidade_reserva") @db.Decimal(18, 4)
  quantidadeRequisitada Decimal @default(0) @map("quantidade_requisitada") @db.Decimal(18, 4)
  quantidadeDevolvida  Decimal @default(0) @map("quantidade_devolvida") @db.Decimal(18, 4)

  /// ex-RequisicaoTerminal: a requisição partiu do chão de fábrica.
  requisicaoTerminal Boolean @default(false) @map("requisicao_terminal")

  /// Derivado de `quantidadeRequisitada`, exceto quando CANCELADA — que é
  /// terminal e não volta atrás (regra do ReservaRN.ValidarReserva).
  status StatusReserva @default(NAO_REQUISITADA)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@unique([ordemProducaoId, itemCodigo, sequencia])
  @@index([ordemProducaoId])
  @@map("reservas")
}

/// ex-EnumTipoMovimento. O legado tinha `UNKNOWN = 0` como sentinela de
/// desserialização; aqui um valor inválido é recusado pelo schema, então ele
/// não tem razão de existir.
enum TipoMovimento {
  PREPARACAO
  REPORTE
  REFUGO
  PARADA
  TROCA_FERRAMENTAL
  TROCA_TURNO
  RECUSA
  ALERTA
  HISTORICO
  ESTORNO
  REQUISICAO
  DEVOLUCAO
  CONSUMO_LOTE
}

/// Movimento de chão de fábrica (migrado de Octopus `Movimento`) — o registro
/// atômico de tudo que acontece num Centro de Trabalho: reporte de produção,
/// parada, refugo, requisição de material, troca de turno.
///
/// É a fonte do cálculo de OEE/TEEP: `MontarPreCalculosOEE` percorre movimentos.
///
/// As seis colunas de quantidade vêm do legado e são intencionais: o Centro de
/// Trabalho define em qual unidade ele reporta (`tipoUnidadeMedida`), e
/// `MovimentoFactory.GetQuantidadeMovimento` lê a coluna correspondente. É essa
/// leitura que a regra do estorno automático usa.
///
/// DESCARTADOS (sem consumidor nas regras portadas): colunas
/// `AuxiliaresManufatura`; as dimensões Comprimento/Largura/Espessura/
/// DiametroInterno/DiametroExterno (específicas de produto dimensional); e a FK
/// para `Erro`, cujo módulo ainda não foi migrado.
///
/// PENDENTES por dependência inexistente: `Ferramenta` (exigida pelo tipo
/// TROCA_FERRAMENTAL) e `QualidadeItem`.
model Movimento {
  idMovimento String        @id @default(uuid()) @db.Uuid
  tipo        TipoMovimento

  centroTrabalhoId String         @map("centro_trabalho_id") @db.Uuid
  centroTrabalho   CentroTrabalho @relation(fields: [centroTrabalhoId], references: [idCentroTrabalho], onDelete: Cascade)

  /// Obrigatório para todos os tipos exceto PARADA/ALERTA/RECUSA/
  /// TROCA_FERRAMENTAL/TROCA_TURNO (regra do MovimentosRN.ValidarMovimento).
  ordemProducaoId String?        @map("ordem_producao_id") @db.Uuid
  ordemProducao   OrdemProducao? @relation(fields: [ordemProducaoId], references: [idOrdemProducao])

  /// Obrigatório para REQUISICAO/DEVOLUCAO.
  reservaId String?  @map("reserva_id") @db.Uuid
  reserva   Reserva? @relation(fields: [reservaId], references: [idReserva])

  /// Quem registrou (usuário do sistema) e quem operava a máquina (crachá).
  usuarioId String  @map("usuario_id") @db.Uuid
  usuario   Usuario @relation("MovimentosRegistrados", fields: [usuarioId], references: [idUsuario])
  /// ex-CdOperador. "Código Operador está vazio." é erro do RN.
  operador  String

  /// Turno é obrigatório ("Informe um turno válido."); `dataTurno` cai no
  /// início do turno quando não informada.
  turnoId   String   @map("turno_id") @db.Uuid
  turno     Turno    @relation(fields: [turnoId], references: [idTurno])
  dataTurno DateTime @map("data_turno")

  inicio DateTime
  fim    DateTime?
  /// Derivado de (fim - inicio) quando fim > inicio. Segundos, unidade explícita.
  duracaoSegundos Int? @map("duracao_segundos")

  /// Se este movimento entra no cálculo de OEE (vem do TipoParada/TipoRefugo).
  consideraOee Boolean @default(true) @map("considera_oee")

  /// Uma coluna por unidade de medida — a do Centro de Trabalho é a que vale.
  quantidadeUnidade    Decimal? @map("quantidade_unidade") @db.Decimal(18, 4)
  quantidadeMetragem   Decimal? @map("quantidade_metragem") @db.Decimal(18, 4)
  quantidadePeso       Decimal? @map("quantidade_peso") @db.Decimal(18, 4)
  quantidadeArea       Decimal? @map("quantidade_area") @db.Decimal(18, 4)
  quantidadeVolume     Decimal? @map("quantidade_volume") @db.Decimal(18, 4)
  quantidadeEspecifica Decimal? @map("quantidade_especifica") @db.Decimal(18, 4)

  /// Classificações. PARADA exige tipoParada; REFUGO exige tipoRefugo;
  /// RECUSA exige tipoRecusa (regras do RN).
  tipoParadaId String?     @map("tipo_parada_id") @db.Uuid
  tipoParada   TipoParada? @relation(fields: [tipoParadaId], references: [idTipoParada])
  tipoRefugoId String?     @map("tipo_refugo_id") @db.Uuid
  tipoRefugo   TipoRefugo? @relation(fields: [tipoRefugoId], references: [idTipoRefugo])
  tipoCausaId  String?     @map("tipo_causa_id") @db.Uuid
  tipoCausa    TipoCausa?  @relation(fields: [tipoCausaId], references: [idTipoCausa])
  tipoRecusaId String?     @map("tipo_recusa_id") @db.Uuid
  tipoRecusa   TipoRecusa? @relation(fields: [tipoRecusaId], references: [idTipoRecusa])

  /// Manutenção: solicitação → atendimento, com os tempos parciais.
  tecnicoManutencao       String?   @map("tecnico_manutencao")
  ordemManutencao         String?   @map("ordem_manutencao")
  fimSolicitacao          DateTime? @map("fim_solicitacao")
  tempoSolicitacaoSegundos Int?     @map("tempo_solicitacao_segundos")
  fimManutencao           DateTime? @map("fim_manutencao")
  tempoManutencaoSegundos Int?      @map("tempo_manutencao_segundos")
  descricaoCausa          String?   @map("descricao_causa")

  /// Integração ERP. `dataIntegracao` preenchida trava cancelamento.
  reportaErp     Boolean   @default(false) @map("reporta_erp")
  dataIntegracao DateTime? @map("data_integracao")

  cancelado             Boolean @default(false)
  usuarioCancelamentoId String? @map("usuario_cancelamento_id") @db.Uuid
  usuarioCancelamento   Usuario? @relation("MovimentosCancelados", fields: [usuarioCancelamentoId], references: [idUsuario])
  observacao            String?

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  /// O monitor online busca "o movimento aberto mais recente" de um conjunto de
  /// tipos num centro — daí o índice por (centro, tipo, inicio).
  @@index([centroTrabalhoId, tipo, inicio])
  @@index([ordemProducaoId])
  @@index([turnoId, dataTurno])
  @@map("movimentos")
}
